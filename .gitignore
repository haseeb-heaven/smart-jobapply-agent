# Private candidate facts, contact details, compensation, and answers.
jobapply_agent/private/

# Local runtime state, databases, logs, and generated exports.
jobapply_agent/data/*
!jobapply_agent/data/.gitkeep
jobapply_agent/output/*
!jobapply_agent/output/.gitkeep
jobapply_agent/*.log

# Local operator configuration and credentials.
**/config.sh
.env
.env.*
!.env.example

# Python, editor, and operating-system artifacts.
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.DS_Store
.venv/
venv/
*.egg-info/

# Local review artifacts.
.lavish/
.worktrees/
.stow-notes.md

# Candidate-supplied material and local job-search notes must never be staged.
resumes/
codex-apply-*.*
.job-tab-monitor.json

# Queue databases can retain candidate-approved evidence and must stay local.
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
