# Private candidate facts, contact details, compensation, and answers.
job_profession/private/

# Local runtime state, databases, logs, and generated exports.
job_profession/data/*
!job_profession/data/.gitkeep
job_profession/output/*
!job_profession/output/.gitkeep
job_profession/*.log

# Local operator configuration and credentials.
**/config.sh
.env
.env.*
!.env.example

# Python, editor, and operating-system artifacts.
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.DS_Store
.venv/
venv/
*.egg-info/

# Local review artifacts.
.lavish/
.stow-notes.md

# Candidate-supplied material and local job-search notes must never be staged.
resumes/
codex-apply-*.*
